<?xml version="1.0" encoding="UTF-8"?>
<!-- An example Maven project that uses the LxrinQL Maven plugin. The integration tests run it with
     -Dlxrin.repo=<file repository with the freshly built LxrinQL artifacts>. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>maven-consumer</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lxrin.version>3.1.0</lxrin.version>
    </properties>

    <repositories>
        <repository>
            <id>lxrin-it</id>
            <url>${lxrin.repo}</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>lxrin-it</id>
            <url>${lxrin.repo}</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
        <dependency>
            <groupId>ch.lxrin</groupId>
            <artifactId>lxrin-ql-core</artifactId>
            <version>${lxrin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>ch.lxrin</groupId>
                <artifactId>lxrin-ql-maven-plugin</artifactId>
                <version>${lxrin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <packageName>com.example.library.db</packageName>
                    <stripTablePrefixes>
                        <prefix>lib_</prefix>
                    </stripTablePrefixes>
                    <tableConstants>
                        <lib_books>BOOKS</lib_books>
                    </tableConstants>
                    <flywayMigrations>
                        <dir>${project.basedir}/src/main/resources/db/migration</dir>
                    </flywayMigrations>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
        </plugins>
    </build>
</project>
